# ──────────────────────────────────────────────────────────────────
# .env.example — a COMMITTED template documenting every env var the app
# needs. Copy it to `.env` (git-ignored) and fill in real values.
#
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (PowerShell)
#
# Rule: .env.example has NO real secrets. .env has real secrets and is
# NEVER committed. This split is a production security standard.
# ──────────────────────────────────────────────────────────────────

# Which environment we are running in. Drives config decisions later
# (e.g. Secure cookies only in production). One of: development | production | test
NODE_ENV=development

# TCP port the HTTP server will listen on (added for real in Phase 2).
PORT=5000

# Phase 4 — PostgreSQL connection string used by Prisma. REQUIRED to boot.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For a hosted DB (Neon/Supabase/Render) paste the connection string they give
# you. Managed providers usually require SSL — append &sslmode=require if so.
DATABASE_URL="postgresql://user:password@localhost:5432/authdb?schema=public"

# Phase 8/17 — DIRECT (unpooled) connection used ONLY by Prisma Migrate. A
# connection POOLER (e.g. Neon's `-pooler` host, PgBouncer) can't run schema
# migrations, so `prisma migrate` uses this direct URL while the app keeps using
# the pooled DATABASE_URL. For a non-pooled DB, set it to the same value (or omit
# — the schema falls back to DATABASE_URL). Same DB, host WITHOUT `-pooler`.
DIRECT_URL="postgresql://user:password@localhost:5432/authdb?schema=public"

# Phase 5 — bcrypt cost (work) factor. Optional; defaults to 12. Allowed 10–15.
# Higher = more secure but slower per login. Measure on your hardware and pick
# the highest value that keeps a login hash around 250–500ms (see docs 14).
# BCRYPT_COST=12

# ── The variables below are placeholders for future phases. ─────────
# They are here as a roadmap; the app does not read them yet.

# Phase 7 — secret for signing/verifying access-token JWTs (HS256). REQUIRED,
# must be >= 32 chars & random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Access-token lifetime (zeit/ms string like 15m, 1h, or seconds). Keep it SHORT.
JWT_ACCESS_TTL="15m"

# Phase 8 — refresh-token lifetime in days (optional; default 7, range 1–365).
# REFRESH_TOKEN_TTL_DAYS=7

# Phase 11 — Resend transactional email. REQUIRED to boot (emails need it).
# Get a key at https://resend.com. onboarding@resend.dev works without a
# verified domain but only delivers to your own account email in test mode.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Auth Server <onboarding@resend.dev>"
# Base URL emailed links point at (your frontend in production).
APP_URL="http://localhost:5000"

# ── Phase 15 — Security hardening ───────────────────────────────────

# CORS allowlist: comma-separated browser ORIGINS allowed to call this API with
# credentials (the refresh cookie). NO wildcard — credentials forbid "*".
# Defaults to common local dev origins if unset. In production set your real
# frontend origin(s), e.g. CORS_ORIGIN="https://app.example.com,https://admin.example.com"
# CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate limiting. Rolling window per client IP. Optional — sensible defaults below.
# RATE_LIMIT_WINDOW_MS=900000   # window length in ms (default 15 min)
# RATE_LIMIT_MAX=100            # max requests / IP / window across the whole API
# AUTH_RATE_LIMIT_MAX=10        # stricter cap on sensitive auth routes
